    <!-- 启动监听 -->
    <string name="watch_desc">调用 Uninstall.watch()，fork 出监听进程。下面显示 native 返回值、监听进程的 pid，以及它此刻是否存活（每秒刷新）。</string>
    <string name="watch_start">启动监听</string>
    <string name="watch_refresh">立即刷新</string>
    <string name="watch_return_label">native 返回值</string>
    <string name="watch_pid_label">监听进程 pid</string>
    <string name="watch_alive_label">监听进程</string>
    <string name="watch_not_started">尚未调用</string>
    <string name="watch_no_pid">未找到</string>
    <string name="watch_alive">存活</string>
    <string name="watch_dead">未运行</string>
    <string name="watch_error">加载原生库失败：%1$s</string>
    <string name="watch_note">返回值是 fork 出的第一个子进程的 pid，它很快退出；真正监听的是孙进程，pid 由它写进 files/observedFile。「存活」只说明现在还在，不代表卸载那一刻还在。</string>

    <!-- 卸载 -->
    <string name="uninstall_desc">弹出系统卸载确认页。先到「启动监听」确认监听进程在运行，再回来卸载，观察结果。</string>
    <string name="uninstall_watch_alive">监听进程存活（pid %1$d）</string>
    <string name="uninstall_watch_dead">监听进程未运行</string>
    <string name="uninstall_button">卸载本应用</string>
    <string name="uninstall_done">已确认卸载</string>
    <string name="uninstall_cancelled">已取消，应用仍在</string>
    <string name="uninstall_unavailable">本机没有可处理卸载的系统组件</string>
    <string name="uninstall_expect">如果 2016 年的原理仍然有效，确认卸载后会自动打开浏览器；新系统上预期什么都不会发生。无论哪种结果，都以真机实际表现为准。</string>

