    <string name="compare_title">方案对比</string>
    <string name="compare_desc">没有任何一种方案能在卸载瞬间让应用自己执行代码。下面每一条都附官方出处，官方没写的标注了。</string>
    <string name="compare_principle">原理</string>
    <string name="compare_latency">时效</string>
    <string name="compare_false">误判</string>
    <string name="compare_requires">账号与权限</string>
    <string name="compare_sources">出处</string>
