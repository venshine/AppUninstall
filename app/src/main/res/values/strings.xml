<resources>
    <string name="app_name" translatable="false">AppUninstall</string>

    <string name="configured">已配置</string>
    <string name="not_configured">未配置</string>
    <string name="need_firebase">未配置 Firebase：把 google-services.json 放到 .private/keys/（或 app/）后重新构建，详见 README。</string>
    <string name="server_hint">先在电脑上启动服务端，并执行 adb reverse tcp:8080 tcp:8080。</string>

    <!-- 首页 -->
    <string name="home_title">App 卸载感知\n现代方案演示</string>
    <string name="home_desc">系统不会在卸载那一刻给应用任何回调。能做的是事后感知：FCM 令牌失效、Analytics 的 app_remove、自建心跳，或者另一个 App 监听卸载广播。</string>
    <string name="home_server">服务端 %1$s</string>
    <string name="demo_fcm">FCM 令牌</string>
    <string name="demo_fcm_desc">获取注册令牌并登记到本地服务端，服务端发消息探测，令牌失效即判定卸载。</string>
    <string name="demo_analytics">Analytics</string>
    <string name="demo_analytics_desc">启用 Firebase Analytics，卸载会产生 app_remove 事件，在控制台或 BigQuery 查看。</string>
    <string name="demo_heartbeat">自建心跳</string>
    <string name="demo_heartbeat_desc">前台每 10 秒、后台每 15 分钟上报，服务端按超时判定疑似流失。</string>
    <string name="demo_compare">方案对比</string>
    <string name="demo_compare_desc">原理、时效、误判与所需账号权限，附官方出处。</string>
    <string name="home_observer">想看卸载广播？安装本仓库的 observer 应用，它监听本应用（com.wx.appuninstall）被移除。</string>
    <string name="home_author" translatable="false">© venshine · Apache-2.0</string>

    <!-- FCM -->
    <string name="fcm_title">FCM 令牌</string>
    <string name="fcm_desc">注册令牌标识这一次安装。卸载后，服务端再向它发消息会得到 UNREGISTERED。</string>
    <string name="fcm_token_label">注册令牌</string>
    <string name="fcm_token_empty">尚未获取</string>
    <string name="fcm_fetch">获取令牌</string>
    <string name="fcm_register">发送到本地服务端</string>
    <string name="fcm_need_token">先获取令牌。</string>
    <string name="fcm_note">令牌会刷新（onNewToken 时本应用会自动重新登记）。服务端探测见 README：POST /probe。</string>

    <!-- Analytics -->
    <string name="analytics_title">Analytics</string>
    <string name="analytics_desc">app_remove 是 Android 上自动收集的事件，描述为应用包被移除（卸载）时触发。它是聚合数据，没有逐用户回调。</string>
    <string name="analytics_id_label">App 实例 ID</string>
    <string name="analytics_enable">启用数据收集</string>
    <string name="analytics_event">记录测试事件 demo_open</string>
    <string name="analytics_steps">查看方式：\n1. Firebase 控制台 → Analytics → Events，找 app_remove（需要事件已被处理）。\n2. 关联 BigQuery 后，在每日导出表 events_YYYYMMDD 里按 event_name 过滤 app_remove。\n3. 它统计所有安装来源，和 Play 管理中心的卸载指标口径不同。</string>
    <string name="analytics_enabled">已启用 Analytics 数据收集。</string>
    <string name="analytics_logged">已记录 demo_open，可在 DebugView 或 Events 里查看。</string>

    <!-- 心跳 -->
    <string name="hb_title">自建心跳</string>
    <string name="hb_desc">App 定期告诉服务端「我还在」，服务端超过阈值没收到就标记为疑似流失。它分不清卸载和只是不用了。</string>
    <string name="hb_id_label">安装标识（卸载重装会变）</string>
    <string name="hb_start">开始前台心跳（每 10 秒）</string>
    <string name="hb_stop">停止前台心跳</string>
    <string name="hb_schedule">安排后台心跳（每 15 分钟）</string>
    <string name="hb_cancel">取消后台心跳</string>
    <string name="hb_check">查询服务端判定</string>
    <string name="hb_idle">尚未上报</string>
    <string name="hb_scheduled">后台心跳已安排。周期任务最小间隔 15 分钟，实际执行受省电策略影响。</string>
    <string name="hb_cancelled">后台心跳已取消。</string>

