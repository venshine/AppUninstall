<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ 包可见性：声明后才能查询默认监听目标是否已安装。
         对「是否收到广播」有无影响，官方文档未明确说明，见 README -->
    <queries>
        <package android:name="com.wx.appuninstall" />
    </queries>

    <application
        android:name="com.wx.appuninstall.common.DemoApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".ObserverActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PACKAGE_FULLY_REMOVED 在 Android 8 隐式广播限制中有例外，可以静态注册；
             PACKAGE_REMOVED 没有，只能在进程存活时动态注册（见 ObserverActivity） -->
        <receiver
            android:name=".RemovalReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
